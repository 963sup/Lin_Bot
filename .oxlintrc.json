{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript"
  ],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "no-invalid-regexp": "error",
    "no-unexpected-multiline": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.ts"
      ],
      "rules": {
        "no-unused-expressions": "error",
        "typescript/triple-slash-reference": "error"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "coverage/**"
  ]
}

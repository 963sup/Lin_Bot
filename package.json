{
  "name": "lin-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LINE Bot engineering foundation (P0/P1)",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "tsx watch src/entrypoints/http.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/entrypoints/http.js",
    "typecheck": "tsc --project tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"eslint.config.mjs\" \"vitest.config.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"eslint.config.mjs\" \"vitest.config.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "architecture:check": "tsx scripts/check-boundaries.ts",
    "env:check": "tsx scripts/validate-env.ts",
    "doctor": "tsx scripts/doctor.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run architecture:check && pnpm run agents:check && pnpm run build",
    "agents:check": "tsx scripts/check-agents.ts"
  },
  "dependencies": {
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.30",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^3.2.4"
  }
}

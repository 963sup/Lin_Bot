{
  "name": "lin-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LINE Bot engineering foundation (P0/P1)",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "tsx watch src/entrypoints/http.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.json",
    "start": "node dist/entrypoints/http.js",
    "typecheck": "tsc --project tsconfig.test.json --noEmit",
    "lint": "biome lint . --error-on-warnings && eslint .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "architecture:check": "depcruise --config .dependency-cruiser.mjs src",
    "env:check": "tsx scripts/validate-env.ts",
    "doctor": "tsx scripts/doctor.ts",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run architecture:check && pnpm run agents:check && pnpm run unused:check && pnpm run build",
    "agents:check": "tsx scripts/check-agents.ts",
    "unused:check": "knip"
  },
  "dependencies": {
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^22.15.30",
    "dependency-cruiser": "18.7.0",
    "eslint": "^9.39.1",
    "knip": "6.44.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^3.2.4"
  }
}
